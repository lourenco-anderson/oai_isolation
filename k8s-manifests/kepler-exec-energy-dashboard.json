{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Kepler Exec Energy/Power per Pod: total, avg, and per-execution",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Summary",
      "type": "row"
    },
    {
      "type": "stat",
      "title": "Total Energy (J) over range",
      "id": 2,
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "range": true,
          "editorMode": "code",
          "expr": "sum by (pod_name) (increase(kepler_container_cpu_joules_total{container_namespace=~\"$namespace\", pod_name=~\"$pod\"}[$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "joule",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Average Power (W) over range",
      "id": 3,
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "range": true,
          "editorMode": "code",
          "expr": "sum by (pod_name) (increase(kepler_container_cpu_joules_total{container_namespace=~\"$namespace\", pod_name=~\"$pod\"}[$__range])) / $__range_s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Energy per Execution (manual count)",
      "id": 4,
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "range": true,
          "editorMode": "code",
          "expr": "sum by (pod_name) (increase(kepler_container_cpu_joules_total{container_namespace=~\"$namespace\", pod_name=~\"$pod\"}[$__range])) / max(1, $execs)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "joule",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 5,
      "panels": [],
      "title": "Time Series",
      "type": "row"
    },
    {
      "type": "timeseries",
      "title": "Instantaneous CPU Power (W) by Pod",
      "id": 6,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "range": true,
          "editorMode": "code",
          "expr": "sum by (pod_name) (kepler_container_cpu_watts{container_namespace=~\"$namespace\", pod_name=~\"$pod\"})",
          "legendFormat": "{{pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 7,
      "panels": [],
      "title": "Optional: Metric-based per-exec",
      "type": "row"
    },
    {
      "type": "stat",
      "title": "Energy per Execution (metric $execs_metric)",
      "id": 8,
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "range": true,
          "editorMode": "code",
          "expr": "sum by (pod_name) (increase(kepler_container_cpu_joules_total{container_namespace=~\"$namespace\", pod_name=~\"$pod\"}[$__range])) / clamp_max(increase($execs_metric{container_namespace=~\"$namespace\", pod_name=~\"$pod\"}[$__range]), 1e12)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "joule", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } }
    },
    {
      "type": "stat",
      "title": "Avg Power per Execution (uses $dur_sum_metric)",
      "id": 9,
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "range": true,
          "editorMode": "code",
          "expr": "sum by (pod_name) (increase(kepler_container_cpu_joules_total{container_namespace=~\"$namespace\", pod_name=~\"$pod\"}[$__range])) / clamp_min(increase($dur_sum_metric{container_namespace=~\"$namespace\", pod_name=~\"$pod\"}[$__range]), 1)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "watt", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } }
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": ["kepler", "energy", "power", "executions"],
  "templating": {
    "list": [
